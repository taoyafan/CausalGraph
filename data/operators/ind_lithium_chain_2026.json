{
  "subgraph": "ind_lithium_chain_2026",
  "note": "锂电产业链环节图：多来源价格/产能/需求节点 + 等权/融合算子；六氟→电解液成本链为『六氟价 × 单吨电解液六氟用量(三源融合)』，锂盐占成本比用于把锂盐成本反推为电解液总成本；缺口率按季度供需比重建。",
  "operators": [
    {
      "id": "ind.li2co3.price",
      "operator": "mixture",
      "inputs": ["ind.li2co3.price.mysteel", "ind.li2co3.price.ppi", "ind.li2co3.price.te"],
      "output_metric": "碳酸锂现货价(多来源等权融合)",
      "unit": "元/吨"
    },
    {
      "id": "ind.liPF6.price",
      "operator": "mixture",
      "inputs": ["ind.liPF6.price.oilchem", "ind.liPF6.price.trendforce"],
      "output_metric": "六氟磷酸锂价(多来源等权融合)",
      "unit": "元/吨"
    },
    {
      "id": "ind.electrolyte.price.ncm",
      "operator": "mixture",
      "inputs": ["ind.electrolyte.price.ncm.trendforce", "ind.electrolyte.price.ncm.oilchem"],
      "output_metric": "三元动力电解液价(多来源等权融合)",
      "unit": "元/吨"
    },
    {
      "id": "ind.electrolyte.price.spread_ncm_lfp",
      "operator": "subtract",
      "inputs": ["ind.electrolyte.price.ncm", "ind.electrolyte.price.lfp.trendforce"],
      "output_metric": "三元与铁锂电解液价差",
      "unit": "元/吨",
      "note": "ncm 为 TrendForce 2026-09-07 与隆众 2026-09-18 两源融合、lfp 取 TrendForce 2026-09-07；分子含更新时点，仅作量级参考"
    },
    {
      "id": "ind.liPF6.capacity_utilization_2025",
      "operator": "divide",
      "inputs": ["ind.liPF6.output.cn_2025", "ind.liPF6.capacity.cn_2025"],
      "output_metric": "六氟磷酸锂产能利用率_2025",
      "unit": "比率"
    },
    {
      "id": "ind.liPF6.gap_ratio_q4_2026",
      "operator": "affine",
      "inputs": ["ind.liPF6.supply_demand_ratio_q4_2026"],
      "params": {"a": 1.0, "b": -1.0},
      "unit": "比率",
      "output_metric": "2026Q4六氟供需缺口率(1−供需比)",
      "note": "本库 affine 语义为 out = a + b·x，故 1−供需比 ⇔ a=1、b=−1；纯结构换算，无主观判断"
    },
    {
      "id": "ind.liPF6.supply_demand_ratio_h2_2026",
      "operator": "mixture",
      "inputs": ["ind.liPF6.supply_demand_ratio_q3_2026", "ind.liPF6.supply_demand_ratio_q4_2026"],
      "unit": "比率",
      "output_metric": "2026H2六氟供需比(两季等权融合)",
      "note": "Q3/Q4 两季等权，仅作季度口径展示；不包含 Q1/Q2（研报未给）"
    },
    {
      "id": "ind.liPF6.q4_demand_implied",
      "operator": "divide",
      "inputs": ["ind.liPF6.gap.q4_2026", "ind.liPF6.gap_ratio_q4_2026"],
      "unit": "万吨",
      "output_metric": "由Q4缺口与缺口率反推的Q4需求",
      "note": "= Q4 单季缺口 ÷ Q4 缺口率；两者同为 2026Q4 口径，分母为分布故结果为分布"
    },
    {
      "id": "ind.liPF6.supply_demand_ratio_fy2026",
      "operator": "divide",
      "inputs": ["ind.liPF6.effective_capacity.fy2026", "ind.liPF6.demand.fy2026"],
      "output_metric": "六氟有效产能/需求_2026",
      "unit": "比率"
    },
    {
      "id": "ind.electrolyte.liPF6_dosage_1gwh",
      "operator": "divide",
      "inputs": ["ind.electrolyte.dosage_1gwh.liPF6", "ind.electrolyte.dosage_1gwh.electrolyte"],
      "unit": "吨/吨",
      "output_metric": "单吨电解液六氟用量(1GWh口径反推)",
      "note": "= 125 吨六氟/GWh ÷ 1000 吨电解液/GWh，两输入同源同日"
    },
    {
      "id": "ind.electrolyte.liPF6_dosage",
      "operator": "mixture",
      "inputs": ["ind.electrolyte.liPF6_dosage.cs", "ind.electrolyte.liPF6_dosage.ofweek", "ind.electrolyte.liPF6_dosage_1gwh"],
      "unit": "吨/吨",
      "output_metric": "单吨电解液六氟用量(三来源等权融合)",
      "note": "三来源：中信证券 0.13(2020)、OFweek 0.12(2021)、1GWh 口径反推(2026)"
    },
    {
      "id": "ind.electrolyte.cost_share.solute_ratio",
      "operator": "affine",
      "inputs": ["ind.electrolyte.cost_share.solute"],
      "output_metric": "电解液成本中溶质(锂盐)占比(比率)",
      "unit": "比率",
      "params": {"a": 0.0, "b": 0.01},
      "note": "供 `ind.electrolyte.liPF6_cost_share` 与证券时报口径等权融合使用（不再是单链乘积的系数）"
    },
    {
      "id": "ind.electrolyte.liPF6_cost_share.hexun_ratio",
      "operator": "affine",
      "inputs": ["ind.electrolyte.liPF6_cost_share.hexun"],
      "params": {"a": 0.0, "b": 0.01},
      "unit": "比率",
      "output_metric": "六氟占电解液成本比例(比率)"
    },
    {
      "id": "ind.electrolyte.liPF6_cost_share",
      "operator": "mixture",
      "inputs": ["ind.electrolyte.cost_share.solute_ratio", "ind.electrolyte.liPF6_cost_share.hexun_ratio"],
      "unit": "比率",
      "output_metric": "六氟占电解液成本比(两来源融合)",
      "note": "民生 2022 口径 50% 与证券时报 2025 口径 40%~50% 等权融合"
    },
    {
      "id": "ind.electrolyte.liPF6_cost",
      "operator": "product",
      "inputs": ["ind.liPF6.price", "ind.electrolyte.liPF6_dosage"],
      "output_metric": "单吨电解液中六氟(锂盐)成本贡献",
      "unit": "元/吨",
      "note": "= 六氟价 × 单吨电解液六氟用量（三源等权融合：0.13 中信证券 / 0.12 OFweek / 1GWh 口径反推）；旧『×锂盐成本占比』等价于暗设 1 吨六氟/吨电解液，已废弃。"
    },
    {
      "id": "ind.electrolyte.cost_implied",
      "operator": "divide",
      "inputs": ["ind.electrolyte.liPF6_cost", "ind.electrolyte.liPF6_cost_share"],
      "unit": "元/吨",
      "output_metric": "由锂盐成本与锂盐占成本比反推的电解液成本",
      "note": "= 锂盐成本贡献 ÷ 锂盐占电解液成本比（民生 2022 口径 50% 与证券时报 2025 口径 40%~50% 等权融合）；隐含『锂盐以外成本结构延续研报口径』，仅作量级参考。"
    },
    {
      "id": "ind.electrolyte.gross_spread",
      "operator": "subtract",
      "inputs": ["ind.electrolyte.price.ncm", "ind.electrolyte.cost_implied"],
      "unit": "元/吨",
      "output_metric": "三元电解液售价与隐含成本之差",
      "note": "分子为三元电解液多源融合报价（TrendForce 2026-09-07 与隆众 2026-09-18）、分母为混期反推成本，仅作量级参考。"
    },
    {
      "id": "ind.electrolyte.gross_margin_implied",
      "operator": "divide",
      "inputs": ["ind.electrolyte.gross_spread", "ind.electrolyte.price.ncm"],
      "unit": "比率",
      "output_metric": "三元电解液隐含毛利率(售价与隐含成本之差÷售价)",
      "note": "基于混期（2020/2021/2022/2025/2026）反推的隐含成本，仅作量级参考；2026-09 实测 P50≈11%、均值≈8%、P10<0。"
    },
    {
      "id": "ind.electrolyte.cost_share.non_solute",
      "operator": "sum",
      "inputs": ["ind.electrolyte.cost_share.solvent", "ind.electrolyte.cost_share.additive"],
      "output_metric": "电解液成本中非锂盐占比",
      "unit": "%"
    },
    {
      "id": "ind.electrolyte.shipment.china_share_h1_2026",
      "operator": "divide",
      "inputs": ["ind.electrolyte.shipment.china_h1_2026", "ind.electrolyte.shipment.global_h1_2026"],
      "output_metric": "中国占全球电解液出货比_2026H1",
      "unit": "比率",
      "note": "分子为中国出货（GGII）、分母为全球出货（SPIR），跨来源口径不同，仅作量级参考。"
    },
    {
      "id": "ind.battery.cost_share.electrolyte_mix",
      "operator": "mixture",
      "inputs": ["ind.battery.cost_share.electrolyte", "ind.battery.cost_share.electrolyte.minisheng"],
      "unit": "%",
      "output_metric": "电解液占电池成本比例(假设锚8%与民生5%等权融合)",
      "note": "协作者假设锚(2026-09-19，5%~10% 老口径支撑)与民生证券 2021 口径(约5%)两来源等权融合；年份口径不同，融合后如实暴露分歧"
    },
    {
      "id": "ind.battery.cost_share.materials_sum",
      "operator": "sum",
      "inputs": ["ind.battery.cost_share.cathode", "ind.battery.cost_share.anode", "ind.battery.cost_share.separator", "ind.battery.cost_share.electrolyte_mix"],
      "output_metric": "电池成本中四大材料合计占比",
      "unit": "%",
      "note": "正极 45%、负极 10%、隔膜 10% 为 2021 研报口径；电解液为两来源融合（协作假设锚 众数 8%、σ=1.5 与 民生 2021 约 5%）。相加隐含『2021 年材料成本结构延续到 2026 年』，仅作结构量级参考。电解液一项为两来源融合值"
    },
    {
      "id": "capchem.battery_chem.utilization_2025",
      "operator": "divide",
      "inputs": ["capchem.battery_chem.output_2025", "capchem.battery_chem.capacity_2025"],
      "output_metric": "新宙邦电池化学品产能利用率_2025",
      "unit": "比率"
    },
    {
      "id": "capchem.contract.catl.total",
      "operator": "sum",
      "inputs": ["capchem.contract.catl.fy2026", "capchem.contract.catl.fy2027", "capchem.contract.catl.fy2028"],
      "output_metric": "新宙邦-宁德长协三年合计",
      "unit": "万吨"
    },
    {
      "id": "capchem.catl_contract_vs_shipment",
      "operator": "divide",
      "inputs": ["capchem.contract.catl.fy2026", "capchem.battery_chem.shipment_h1_2026"],
      "output_metric": "宁德2026年长协量/新宙邦2026H1出货量(时段不一致)",
      "unit": "比率",
      "note": "口径差异说明：分子为 2026 全年合同量（万吨（年度长协量）），分母为 2026 上半年出货量（万吨，2026H1），时间跨度不一致（全年合同 vs 半年实际），该比值仅作结构性参考，不可解读为覆盖率/完成率。"
    },
    {
      "id": "capchem.liPF6.capacity_share",
      "operator": "divide",
      "inputs": ["capchem.liPF6.capacity_2026", "ind.liPF6.capacity.cn_2025"],
      "output_metric": "新宙邦六氟产能占全国比值",
      "unit": "比率",
      "note": "口径差异说明：分子为新宙邦（江西石磊）2026 年名义产能（万吨，2026 年口径），分母为 2025 年全国产能（万吨/年，2025 年口径），年份口径不完全一致，该比值仅作量级参考。"
    },
    {
      "id": "catl.capchem_vs_yongtai_contract",
      "operator": "divide",
      "inputs": ["capchem.contract.catl.total", "catl.electrolyte.contract.yongtai.total"],
      "output_metric": "宁德对新宙邦/对永太长协量比",
      "unit": "比率"
    },
    {
      "id": "ind.liPF6.utilization.cn_2025_ratio",
      "operator": "affine",
      "inputs": ["ind.liPF6.utilization.cn_2025"],
      "params": {"a": 0.0, "b": 0.01},
      "unit": "比率",
      "output_metric": "六氟开工率_2025(统计口径，比率)",
      "note": "% 到比率的结构性单位换算常数（b=0.01），与 ind.electrolyte.cost_share.solute_ratio 同做法；无主观性"
    },
    {
      "id": "ind.liPF6.utilization.combined_2025",
      "operator": "mixture",
      "inputs": ["ind.liPF6.utilization.cn_2025_ratio", "ind.liPF6.capacity_utilization_2025"],
      "unit": "比率",
      "output_metric": "六氟开工率_2025(统计口径与产能口径融合)",
      "note": "两口径交叉（统计机构口径 63.0% 与产量/产能口径）；两者同源于 ChemNet，属口径交叉而非独立多来源"
    },
    {
      "id": "ind.battery.liPF6_intensity_fy2026",
      "operator": "divide",
      "inputs": ["ind.liPF6.demand.fy2026", "ind.battery.demand.global_fy2026"],
      "unit": "万吨/GWh",
      "display_unit": "吨/GWh",
      "display_scale": 0.0001,
      "output_metric": "单位电池需求的六氟磷酸锂单耗_2026",
      "note": "六氟需求预测/全球锂电需求预测；两个输入的年份口径均为 2026 年"
    },
    {
      "id": "ind.liPF6.cn_supply_demand_ratio_2026.zy",
      "operator": "divide",
      "inputs": ["ind.liPF6.output.cn_2026", "ind.liPF6.demand.cn_2026"],
      "unit": "比率",
      "output_metric": "中国六氟产量/需求量比_2026E(智研口径)",
      "note": "同源同为中国口径；比值>1 反映中国产量覆盖全球需求（含出口），不能读作中国自用过剩"
    },
    {
      "id": "ind.liPF6.price.vs_forecast_center",
      "operator": "divide",
      "inputs": ["ind.liPF6.price", "ind.liPF6.price.center_fy2026"],
      "unit": "比率",
      "output_metric": "六氟现货价/2026预测中枢",
      "note": "分子为 2026-09 多源融合现货价、分母为 2026-06 券商预测中枢；时点不同，仅作分歧展示，不作结论"
    },
    {
      "id": "ind.liPF6.li2co3_dosage",
      "operator": "mixture",
      "inputs": ["ind.liPF6.li2co3_dosage.cs", "ind.liPF6.li2co3_dosage.yanjiu"],
      "output_metric": "六氟碳酸锂单耗(两源等权融合)",
      "unit": "吨/吨"
    },
    {
      "id": "ind.liPF6.ahf_dosage",
      "operator": "mixture",
      "inputs": ["ind.liPF6.ahf_dosage.yanjiu", "ind.liPF6.ahf_dosage.ph"],
      "output_metric": "六氟无水氟化氢单耗(两源等权融合)",
      "unit": "吨/吨"
    },
    {
      "id": "ind.liPF6.cost.li2co3",
      "operator": "product",
      "inputs": ["ind.li2co3.price", "ind.liPF6.li2co3_dosage"],
      "output_metric": "六氟成本中碳酸锂贡献",
      "unit": "元/吨",
      "note": "= 碳酸锂价 × 碳酸锂单耗"
    },
    {
      "id": "ind.liPF6.cost.ahf",
      "operator": "product",
      "inputs": ["ind.ahf.price", "ind.liPF6.ahf_dosage"],
      "output_metric": "六氟成本中无水氟化氢贡献",
      "unit": "元/吨",
      "note": "= AHF 价 × AHF 单耗"
    },
    {
      "id": "ind.liPF6.cost.materials_implied",
      "operator": "sum",
      "inputs": ["ind.liPF6.cost.li2co3", "ind.liPF6.cost.ahf"],
      "output_metric": "六氟两大原料成本合计(碳酸锂+AHF)",
      "unit": "元/吨",
      "note": "未含五氯化磷（缺价格节点）；与行业综合成本(7.1~7.3 万元/吨)对比看量级"
    },
    {
      "id": "ind.liPF6.price.vs_cost",
      "operator": "divide",
      "inputs": ["ind.liPF6.price", "ind.liPF6.cost.industry_2026"],
      "output_metric": "六氟现货价/行业综合成本",
      "unit": "比率",
      "note": "分子为 2026-09 多源融合现货价、分母为 2026-06 行业综合成本；时点不同，仅作量级对比"
    },
    {
      "id": "ind.battery.electrolyte_cost_per_gwh",
      "operator": "product",
      "inputs": ["ind.electrolyte.dosage_1gwh.electrolyte", "ind.electrolyte.price.ncm"],
      "output_metric": "每GWh电池的电解液成本",
      "unit": "元/GWh",
      "note": "= 1000 吨电解液/GWh × 三元电解液均价"
    },
    {
      "id": "ind.battery.cost_share.electrolyte_mix_ratio",
      "operator": "affine",
      "inputs": ["ind.battery.cost_share.electrolyte_mix"],
      "params": {"a": 0.0, "b": 0.01},
      "output_metric": "电解液占电池成本比(比率化)",
      "unit": "比率",
      "note": "% → 比率的结构性单位换算"
    },
    {
      "id": "ind.battery.cost_implied_per_gwh",
      "operator": "divide",
      "inputs": ["ind.battery.electrolyte_cost_per_gwh", "ind.battery.cost_share.electrolyte_mix_ratio"],
      "output_metric": "由电解液成本与占比反推的电池单位成本",
      "unit": "元/GWh",
      "note": "隐含『电解液占电池成本比可外推』，仅作量级参考"
    },
    {
      "id": "ind.battery.cost_implied_per_wh",
      "operator": "affine",
      "inputs": ["ind.battery.cost_implied_per_gwh"],
      "params": {"a": 0.0, "b": 1e-9},
      "output_metric": "反推电池单位成本(元/Wh)",
      "unit": "元/Wh",
      "note": "GWh → Wh 的结构性单位换算"
    },
    {
      "id": "ind.battery.implied_cost_vs_price",
      "operator": "divide",
      "inputs": ["ind.battery.cost_implied_per_wh", "catl.price.battery_avg_2025"],
      "output_metric": "反推单位成本/宁德销售均价",
      "unit": "比率",
      "note": "成本口径与售价口径不可直接比较，仅作量级展示"
    },
    {
      "id": "capchem.battery_chem.avg_price_vs_ind",
      "operator": "divide",
      "inputs": ["capchem.battery_chem.avg_price_h1_2026", "ind.electrolyte.price.ncm"],
      "output_metric": "新宙邦电池化学品均价/环节电解液均价",
      "unit": "比率",
      "note": "分子为公司电池化学品分部均价（含溶剂/添加剂等全线产品）、分母为环节电解液均价，口径不同"
    },
    {
      "id": "catl.utilization_check_2025",
      "operator": "divide",
      "inputs": ["catl.production_2025", "catl.capacity_2025"],
      "unit": "比率",
      "output_metric": "产能利用率校验_2025(产量/产能)",
      "note": "= 748/772；与披露值 96.89% 交叉核对"
    },
    {
      "id": "catl.shipment_vs_production_2025",
      "operator": "divide",
      "inputs": ["catl.shipment_2025", "catl.production_2025"],
      "unit": "比率",
      "output_metric": "销量/产量_2025(产销率)",
      "note": "= 661/748"
    },
    {
      "id": "catl.margin.spread_power_ess_2025",
      "operator": "subtract",
      "inputs": ["catl.gross_margin.power_2025", "catl.gross_margin.ess_2025"],
      "unit": "%",
      "output_metric": "动力与储能毛利率差_2025",
      "note": "动力毛利率减储能毛利率；负值表示储能毛利率更高"
    },
    {
      "id": "capchem.battery_chem.avg_price_growth_h1_2026",
      "operator": "divide",
      "inputs": ["capchem.battery_chem.avg_price_h1_2026", "capchem.battery_chem.avg_price_2025"],
      "unit": "比率",
      "output_metric": "电池化学品均价_2026H1/2025",
      "note": "时点不同（半年 vs 全年），仅作方向参考"
    },
    {
      "id": "ind.liPF6.cost.materials_vs_industry",
      "operator": "divide",
      "inputs": ["ind.liPF6.cost.materials_implied", "ind.liPF6.cost.industry_2026"],
      "unit": "比率",
      "output_metric": "六氟原料成本合计/行业综合成本",
      "note": "分子只含碳酸锂与 AHF（未含五氯化磷与费用），比值应小于 1"
    },
    {
      "id": "ind.liPF6.utilization_vs_supply_demand",
      "operator": "divide",
      "inputs": ["ind.liPF6.capacity_utilization_2025", "ind.liPF6.supply_demand_ratio_fy2026"],
      "unit": "比率",
      "output_metric": "开工率_2025/供需比_2026",
      "note": "年份口径不同，仅作量级参考"
    },
    {
      "id": "ind.electrolyte.market_size_h1_2026",
      "operator": "product",
      "inputs": ["ind.electrolyte.shipment.global_h1_2026", "ind.electrolyte.price.ncm"],
      "unit": "万元",
      "output_metric": "全球电解液市场规模隐含值_2026H1",
      "note": "= 出货(万吨) × 均价(元/吨)，数值单位为万元"
    },
    {
      "id": "ind.electrolyte.market_size_100m_h1_2026",
      "operator": "affine",
      "inputs": ["ind.electrolyte.market_size_h1_2026"],
      "params": {"a": 0.0, "b": 0.0001},
      "unit": "亿元",
      "output_metric": "全球电解液市场规模隐含值_2026H1(亿元)",
      "note": "万元 → 亿元的结构性单位换算 a=0,b=1e-4"
    },
    {
      "id": "ind.electrolyte.cost_share.solute_vs_non_solute",
      "operator": "divide",
      "inputs": ["ind.electrolyte.cost_share.solute", "ind.electrolyte.cost_share.non_solute"],
      "unit": "比率",
      "output_metric": "锂盐成本占比/非锂盐占比",
      "note": "同源（民生 2022）两个占比相除"
    },
    {
      "id": "ind.liPF6.demand.cn_vs_global",
      "operator": "divide",
      "inputs": ["ind.liPF6.demand.cn_2026", "ind.liPF6.demand.fy2026"],
      "unit": "比率",
      "output_metric": "中国需求/全球需求_2026E",
      "note": "分子智研中国口径、分母中信建投全球口径；口径不同，仅作份额量级参考"
    },
    {
      "id": "capchem.battery_chem.shipment_vs_output",
      "operator": "divide",
      "inputs": ["capchem.battery_chem.shipment_h1_2026", "capchem.battery_chem.output_2025"],
      "unit": "比率",
      "output_metric": "2026H1出货/2025产量",
      "note": "时段不一致（半年出货 vs 全年产量），仅作结构参考"
    },
    {
      "id": "capchem.battery_chem.electrolyte_rev_h1_2026",
      "operator": "product",
      "inputs": ["capchem.battery_chem.shipment_h1_2026", "ind.electrolyte.price.ncm"],
      "unit": "万元",
      "output_metric": "新宙邦电解液隐含收入_2026H1",
      "note": "= 电解液出货(万吨) × 环节电解液均价(元/吨)，数值单位为万元；两者均为电解液口径"
    },
    {
      "id": "capchem.battery_chem.electrolyte_rev_100m_h1_2026",
      "operator": "affine",
      "inputs": ["capchem.battery_chem.electrolyte_rev_h1_2026"],
      "params": {"a": 0.0, "b": 0.0001},
      "unit": "亿元",
      "output_metric": "新宙邦电解液隐含收入_2026H1(亿元)",
      "note": "万元 → 亿元的结构性单位换算"
    },
    {
      "id": "catl.unit_margin_2025",
      "operator": "subtract",
      "inputs": ["catl.price.battery_avg_2025", "ind.battery.cost_implied_per_wh"],
      "unit": "元/Wh",
      "output_metric": "宁德单位毛利_2025(均价−反推成本)",
      "note": "反推成本为混口径，仅作量级参考；负值说明占比锚偏低或价口径不一致"
    },
    {
      "id": "catl.profit_per_gwh_fy2026",
      "operator": "divide",
      "inputs": ["catl.profit.fy2026", "catl.shipment_2025"],
      "unit": "亿元/GWh",
      "output_metric": "单GWh归母净利_2026E",
      "note": "分子为 2026E 券商一致预期、分母为 2025 实际销量；跨期，仅作量级参考"
    },
    {
      "id": "catl.utilization_2025_ratio",
      "operator": "affine",
      "inputs": ["catl.utilization_2025"],
      "params": {"a": 0.0, "b": 0.01},
      "unit": "比率",
      "output_metric": "宁德产能利用率_2025(比率化)",
      "note": "% → 比率的结构性单位换算（b=0.01），无主观性"
    },
    {
      "id": "catl.utilization_gap_2025",
      "operator": "subtract",
      "inputs": ["catl.utilization_2025_ratio", "catl.utilization_check_2025"],
      "unit": "比率",
      "output_metric": "披露利用率与校验利用率之差_2025",
      "note": "披露值 96.89% 与产量/产能(748/772) 之差，应接近 0；两个输入同口径同年"
    }
  ]
}
