      "inputs": ["seg.electronic.rev_h1_2026", "seg.electronic.g3", "seg.electronic.margin_h1_2026", "capchem.margin_fy_factor"],
      "output_metric": "电子信息化学品_全年毛利_2026",
      "unit": "亿元"
    },
    {
      "id": "seg.fluorine.gp_fy2026",
      "operator": "seg_gross_profit",
      "inputs": ["seg.fluorine.rev_h1_2026", "seg.fluorine.g3", "seg.fluorine.margin_h1_2026", "capchem.margin_fy_factor"],
      "output_metric": "有机氟化学品_全年毛利_2026",
      "unit": "亿元"
    },
    {
