{
  "subgraph": "capchem_segments_2026",
  "note": "新宙邦 2026 全年归母净利润——分业务自下而上（不含券商）。电池化学品 H2 收入 = 电解液收入（H1 电解液单吨收入 × (1+单吨收入环比) × H2 电解液出货）+ 非电解液外销收入（H1 非电解液收入 × (1 + k × DMC 变动) × 外销量系数）；H1 电解液收入 = 分部收入 × (2025 F&S 电解液占比 × 漂移)；单吨收入环比 = mixture(电解液现货锚, 成本传导路径)；H2 毛利率偏离 = mixture(东吴锚, 券商锚, 成本传导推导)。电子/氟/其他业务全年毛利由 seg_gross_profit(H1收入, g3, H1毛利率, 全年调整系数) 一步算出；其中电子/氟的 g3 已由“跨期环比外推”改为“同季同比驱动”：g3 = growth(2026H2, 2026H1)、 2026H2 = 2025H2(audited派生)×(1+H2同比增速_融合)，H2同比增速由多条证据锰 mixture 融合(每份证据一个数据节点、再合并计算，不删证据)：电子=动量延续锰+增速放缓锰、有机氟=技改爬坡锰+产能上限锰。避免拿跨年 H2→H1 的环比去代年内 H1→H2 的季节性方向错配；其他业务占比<1% 仍用原子假设 g3。算子皆纯数学(C_op=1.0，定义即代码)，主观性集中在 assumptions 文件的假设节点——本文件输入的数据节点含 audited（公司披露）与 assumption/analyst_estimate（我方/券商锚）两类——及两个调整系数。",
  "operators": [
    {
      "id": "seg.other.g1_2025",
      "operator": "hoh_growth",
      "inputs": ["seg.other.rev_fy_2025", "seg.other.rev_h1_2025"],
      "output_metric": "其他业务_2025_H1→H2季节性环比增速(g3基础)",
      "unit": "比率"
    },
    {
      "id": "seg.electronic.rev_h2_2025",
      "operator": "subtract",
      "inputs": ["seg.electronic.rev_fy_2025", "seg.electronic.rev_h1_2025"],
      "output_metric": "电子信息化学品_2025H2营业收入(audited派生)",
      "unit": "亿元"
    },
    {
      "id": "seg.electronic.yoy_h2",
      "operator": "mixture",
      "inputs": ["seg.electronic.yoy_h2_momentum", "seg.electronic.yoy_h2_normalize"],
      "output_metric": "电子信息化学品_2026H2营收同比增速_融合",
      "unit": "比率"
    },
    {
      "id": "seg.electronic.yoy_h2_plus1",
      "operator": "affine",
      "inputs": ["seg.electronic.yoy_h2"],
      "params": {"a": 1.0, "b": 1.0},
      "output_metric": "电子信息化学品_H2营收同比增速+1",
      "unit": "比率"
    },
    {
      "id": "seg.electronic.rev_h2_2026",
      "operator": "product",
      "inputs": ["seg.electronic.rev_h2_2025", "seg.electronic.yoy_h2_plus1"],
      "output_metric": "电子信息化学品_2026H2营业收入(H2同比驱动)",
      "unit": "亿元"
    },
    {
      "id": "seg.fluorine.rev_h2_2025",
      "operator": "subtract",
      "inputs": ["seg.fluorine.rev_fy_2025", "seg.fluorine.rev_h1_2025"],
      "output_metric": "有机氟化学品_2025H2营业收入(audited派生)",
      "unit": "亿元"
    },
    {
      "id": "seg.fluorine.yoy_h2",
      "operator": "mixture",
      "inputs": ["seg.fluorine.yoy_h2_retrofit", "seg.fluorine.yoy_h2_capcap"],
      "output_metric": "有机氟化学品_2026H2营收同比增速_融合",
      "unit": "比率"
    },
    {
      "id": "seg.fluorine.yoy_h2_plus1",
      "operator": "affine",
      "inputs": ["seg.fluorine.yoy_h2"],
      "params": {"a": 1.0, "b": 1.0},
      "output_metric": "有机氟化学品_H2营收同比增速+1",
      "unit": "比率"
    },
    {
      "id": "seg.fluorine.rev_h2_2026",
      "operator": "product",
      "inputs": ["seg.fluorine.rev_h2_2025", "seg.fluorine.yoy_h2_plus1"],
      "output_metric": "有机氟化学品_2026H2营业收入(H2同比驱动)",
      "unit": "亿元"
    },
    {
      "id": "seg.other.g2_cross",
      "operator": "cross_growth",
      "inputs": ["seg.other.rev_h1_2026", "seg.other.rev_fy_2025", "seg.other.rev_h1_2025"],
      "output_metric": "其他业务_2025H2→2026H1跨年环比增速(锚，仅参考)",
      "unit": "比率"
    },
    {
      "id": "seg.electronic.g3",
      "operator": "growth",
      "inputs": ["seg.electronic.rev_h2_2026", "seg.electronic.rev_h1_2026"],
      "output_metric": "电子信息化学品_2026_H1→H2收入环比增速(由H2同比驱动派生)",
      "unit": "比率"
    },
    {
      "id": "seg.fluorine.g3",
      "operator": "growth",
      "inputs": ["seg.fluorine.rev_h2_2026", "seg.fluorine.rev_h1_2026"],
      "output_metric": "有机氟化学品_2026_H1→H2收入环比增速(由H2同比驱动派生)",
      "unit": "比率"
    },
    {
      "id": "seg.electronic.gp_fy2026",
      "operator": "seg_gross_profit",
      "inputs": ["seg.electronic.rev_h1_2026", "seg.electronic.g3", "seg.electronic.margin_h1_2026", "capchem.margin_fy_factor"],
      "output_metric": "电子信息化学品_全年毛利_2026",
      "unit": "亿元"
    },
    {
      "id": "seg.fluorine.gp_fy2026",
      "operator": "seg_gross_profit",
      "inputs": ["seg.fluorine.rev_h1_2026", "seg.fluorine.g3", "seg.fluorine.margin_h1_2026", "capchem.margin_fy_factor"],
      "output_metric": "有机氟化学品_全年毛利_2026",
      "unit": "亿元"
    },
    {
      "id": "seg.other.gp_fy2026",
      "operator": "seg_gross_profit",
      "inputs": ["seg.other.rev_h1_2026", "seg.other.g3", "seg.other.margin_h1_2026", "capchem.margin_fy_factor"],
