      "unit": "亿元"
    },
    {
      "id": "capchem.gross_profit.fy2026",
      "operator": "sum",
      "inputs": ["seg.battery.gp_fy2026", "seg.electronic.gp_fy2026", "seg.fluorine.gp_fy2026", "seg.other.gp_fy2026"],
      "output_metric": "全年毛利合计_2026",
      "unit": "亿元"
    },
    {
      "id": "seg.battery.gp_h1_2026",
      "operator": "product",
      "inputs": ["seg.battery.rev_h1_2026", "seg.battery.margin_h1_2026"],
