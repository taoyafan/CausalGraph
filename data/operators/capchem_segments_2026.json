      "inputs": ["seg.electronic.rev_h1_2026", "seg.electronic.margin_h1_2026"],
      "output_metric": "电子信息化学品_H1毛利_2026",
      "unit": "亿元"
    },
    {
      "id": "seg.fluorine.gp_h1_2026",
      "operator": "product",
      "inputs": ["seg.fluorine.rev_h1_2026", "seg.fluorine.margin_h1_2026"],
