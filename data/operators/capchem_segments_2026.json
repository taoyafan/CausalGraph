    },
    {
      "id": "seg.battery.shipment_h1_2026",
      "operator": "mixture",
      "inputs": ["capchem.battery_chem.shipment_h1_2026", "seg.battery.shipment_h1_2026.dongwu"],
      "output_metric": "电池化学品_H1电解液出货量_2026(EVTank与东吴同期融合)",
      "unit": "万吨",
      "note": "两源同期（2026H1）同量，差约 0.5%"
    },
    {
