{
  "subgraph": "kbl_forecast_fy2026",
  "note": "Kingboard Laminates 2026 forecast graph. Major CCL and copper-foil expansion starts in 2027, so 2026 volume assumptions stay restrained. The core attributable-profit target excludes H2 fair-value movement; the reported attributable-profit target includes it. Consensus Net Income matching basis is unclear, so profit-versus-consensus outputs retain that basis caveat.",
  "operators": [
    {"id": "kbl.h2.volume_factor", "operator": "product", "inputs": ["kbl.h2.company_supply_support_factor", "kbl.h2.ai_demand_factor", "kbl.h2.consumer_drag_factor"], "output_metric": "H2_volume_factor", "unit": "factor"},
    {"id": "kbl.h2.unit_cost_factor", "operator": "product", "inputs": ["kbl.h2.raw_material_inflation_factor", "kbl.h2.vertical_integration_mitigation_factor"], "output_metric": "H2_unit_cost_factor", "unit": "factor"},
    {"id": "kbl.h2.revenue", "operator": "product", "inputs": ["kbl.h1.revenue", "kbl.h2.volume_factor", "kbl.h2.asp_uplift_factor"], "output_metric": "Revenue_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.cogs", "operator": "product", "inputs": ["kbl.h1.cogs", "kbl.h2.volume_factor", "kbl.h2.unit_cost_factor"], "output_metric": "Cost_of_sales_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.gross_profit", "operator": "subtract", "inputs": ["kbl.h2.revenue", "kbl.h2.cogs"], "output_metric": "Gross_profit_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.distribution_expense", "operator": "product", "inputs": ["kbl.h1.distribution_expense", "kbl.h2.volume_factor"], "output_metric": "Distribution_expense_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.finance_cost", "operator": "product", "inputs": ["kbl.h1.finance_cost", "kbl.h2.finance_cost_factor"], "output_metric": "Finance_cost_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.pre_admin", "operator": "subtract", "inputs": ["kbl.h2.gross_profit", "kbl.h2.distribution_expense"], "output_metric": "H2_profit_before_administrative_expense", "unit": "HKD"},
    {"id": "kbl.h2.pre_finance", "operator": "subtract", "inputs": ["kbl.h2.pre_admin", "kbl.h1.administrative_expense"], "output_metric": "H2_profit_before_finance_cost", "unit": "HKD"},
    {"id": "kbl.h2.after_finance", "operator": "subtract", "inputs": ["kbl.h2.pre_finance", "kbl.h2.finance_cost"], "output_metric": "H2_profit_after_finance_cost", "unit": "HKD"},
    {"id": "kbl.h2.core_pbt", "operator": "sum", "inputs": ["kbl.h2.after_finance", "kbl.h1.other_income_gains_losses"], "output_metric": "Core_profit_before_taxation_2026H2", "unit": "HKD"},
    {"id": "kbl.h1.effective_tax_rate", "operator": "divide", "inputs": ["kbl.h1.income_tax", "kbl.h1.pbt"], "output_metric": "Effective_tax_rate_2026H1", "unit": "ratio"},
    {"id": "kbl.h2.core_tax", "operator": "product", "inputs": ["kbl.h2.core_pbt", "kbl.h1.effective_tax_rate"], "output_metric": "Core_income_tax_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.core_net", "operator": "subtract", "inputs": ["kbl.h2.core_pbt", "kbl.h2.core_tax"], "output_metric": "Core_net_profit_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.core_attributable", "operator": "subtract", "inputs": ["kbl.h2.core_net", "kbl.h1.nci_profit"], "output_metric": "Core_profit_attributable_to_owners_2026H2", "unit": "HKD"},
    {"id": "kbl.fy2026.core_attributable_profit", "operator": "sum", "inputs": ["kbl.h1.attributable_profit", "kbl.h2.core_attributable"], "output_metric": "Core_profit_attributable_to_owners_FY2026_excluding_H2_fair_value_movement", "unit": "HKD"},
    {"id": "kbl.h2.reported_pbt", "operator": "sum", "inputs": ["kbl.h2.core_pbt", "kbl.h2.fair_value_result"], "output_metric": "Reported_profit_before_taxation_2026H2_including_fair_value_movement", "unit": "HKD"},
    {"id": "kbl.h2.reported_tax", "operator": "product", "inputs": ["kbl.h2.reported_pbt", "kbl.h1.effective_tax_rate"], "output_metric": "Reported_income_tax_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.reported_net", "operator": "subtract", "inputs": ["kbl.h2.reported_pbt", "kbl.h2.reported_tax"], "output_metric": "Reported_net_profit_2026H2", "unit": "HKD"},
    {"id": "kbl.h2.reported_attributable", "operator": "subtract", "inputs": ["kbl.h2.reported_net", "kbl.h1.nci_profit"], "output_metric": "Reported_profit_attributable_to_owners_2026H2", "unit": "HKD"},
    {"id": "kbl.fy2026.reported_attributable_profit", "operator": "sum", "inputs": ["kbl.h1.attributable_profit", "kbl.h2.reported_attributable"], "output_metric": "Reported_profit_attributable_to_owners_FY2026_including_H2_fair_value_movement", "unit": "HKD"},
    {"id": "kbl.fy2026.revenue", "operator": "sum", "inputs": ["kbl.h1.revenue", "kbl.h2.revenue"], "output_metric": "Revenue_FY2026", "unit": "HKD"},
    {"id": "kbl.fy2026.core_profit_vs_consensus", "operator": "subtract", "inputs": ["kbl.fy2026.core_attributable_profit", "kbl.consensus.fy2026.net_income"], "output_metric": "Core_attributable_profit_minus_consensus_net_income_FY2026_basis_unclear", "unit": "HKD"},
    {"id": "kbl.fy2026.reported_profit_vs_consensus", "operator": "subtract", "inputs": ["kbl.fy2026.reported_attributable_profit", "kbl.consensus.fy2026.net_income"], "output_metric": "Reported_attributable_profit_minus_consensus_net_income_FY2026_basis_unclear", "unit": "HKD"},
    {"id": "kbl.fy2026.revenue_vs_consensus", "operator": "subtract", "inputs": ["kbl.fy2026.revenue", "kbl.consensus.fy2026.revenue"], "output_metric": "Revenue_minus_consensus_FY2026", "unit": "HKD"}
  ]
}
