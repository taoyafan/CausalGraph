{
  "subgraph": "kbl_forecast_fy2026",
  "note": "建滔积层板 2026 年预测图。保留收入与成本的详细业务驱动，并以实际上半年毛利转税前经营利润转换率及经确认的窄幅调整系数简化下半年会计项目。2026 年归母利润预测不含未来公允价值变动。",
  "operators": [
    {"id": "kbl.h2.volume_factor", "operator": "product", "inputs": ["kbl.h2.company_supply_support_factor", "kbl.h2.ai_demand_factor", "kbl.h2.consumer_drag_factor"], "output_metric": "下半年销量系数", "unit": "factor", "display_unit": "倍", "display_scale": 1},
    {"id": "kbl.h2.unit_cost_factor", "operator": "product", "inputs": ["kbl.h2.raw_material_inflation_factor", "kbl.h2.vertical_integration_mitigation_factor"], "output_metric": "下半年单位成本系数", "unit": "factor", "display_unit": "倍", "display_scale": 1},
    {"id": "kbl.h2.revenue", "operator": "product", "inputs": ["kbl.h1.revenue", "kbl.h2.volume_factor", "kbl.h2.asp_uplift_factor"], "output_metric": "2026年下半年收入", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.cogs", "operator": "product", "inputs": ["kbl.h1.cogs", "kbl.h2.volume_factor", "kbl.h2.unit_cost_factor"], "output_metric": "2026年下半年销售成本", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.gross_profit", "operator": "subtract", "inputs": ["kbl.h2.revenue", "kbl.h2.cogs"], "output_metric": "2026年下半年毛利", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h1.gross_profit", "operator": "subtract", "inputs": ["kbl.h1.revenue", "kbl.h1.cogs"], "output_metric": "2026年上半年毛利", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h1.after_distribution", "operator": "subtract", "inputs": ["kbl.h1.gross_profit", "kbl.h1.distribution_expense"], "output_metric": "2026年上半年扣除分销费用后利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h1.after_admin", "operator": "subtract", "inputs": ["kbl.h1.after_distribution", "kbl.h1.administrative_expense"], "output_metric": "2026年上半年扣除行政费用后利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h1.pre_finance_operating_profit", "operator": "sum", "inputs": ["kbl.h1.after_admin", "kbl.h1.other_income_gains_losses"], "output_metric": "2026年上半年税前经营利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h1.gross_to_pre_finance_rate", "operator": "divide", "inputs": ["kbl.h1.pre_finance_operating_profit", "kbl.h1.gross_profit"], "output_metric": "2026年上半年毛利转税前经营利润率", "unit": "ratio", "display_unit": "比例", "display_scale": 1},
    {"id": "kbl.h2.pre_finance_operating_profit", "operator": "product", "inputs": ["kbl.h2.gross_profit", "kbl.h1.gross_to_pre_finance_rate", "kbl.h2.accounting_conversion_factor"], "output_metric": "2026年下半年税前经营利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.finance_cost", "operator": "product", "inputs": ["kbl.h1.finance_cost", "kbl.h2.finance_cost_factor"], "output_metric": "2026年下半年融资成本", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.core_pbt", "operator": "subtract", "inputs": ["kbl.h2.pre_finance_operating_profit", "kbl.h2.finance_cost"], "output_metric": "2026年下半年核心税前利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h1.effective_tax_rate", "operator": "divide", "inputs": ["kbl.h1.income_tax", "kbl.h1.pbt"], "output_metric": "2026年上半年实际税率", "unit": "ratio", "display_unit": "比例", "display_scale": 1},
    {"id": "kbl.h2.core_tax", "operator": "product", "inputs": ["kbl.h2.core_pbt", "kbl.h1.effective_tax_rate"], "output_metric": "2026年下半年核心所得税", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.core_attributable", "operator": "subtract", "inputs": ["kbl.h2.core_pbt", "kbl.h2.core_tax"], "output_metric": "2026年下半年核心归母利润（非控股权益省略，因披露的上半年金额不重大）", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.fy2026.core_attributable_profit", "operator": "sum", "inputs": ["kbl.h1.attributable_profit", "kbl.h2.core_attributable"], "output_metric": "2026年归母利润预测（主要预测口径，不含未来公允价值变动）", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.fy2026.revenue", "operator": "sum", "inputs": ["kbl.h1.revenue", "kbl.h2.revenue"], "output_metric": "2026财年收入", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000}
  ]
}
