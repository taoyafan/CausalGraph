    {"id": "kbl.h2.fair_value_result", "operator": "product", "inputs": ["kbl.h1.fair_value_equity_loss", "kbl.h2.fair_value_signed_multiplier"], "output_metric": "下半年权益工具公允价值结果（正数为收益、负数为亏损）", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.reported_pbt", "operator": "sum", "inputs": ["kbl.h2.core_pbt", "kbl.h2.fair_value_result"], "output_metric": "2026年下半年报表税前利润（含公允价值变动）", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.reported_tax", "operator": "product", "inputs": ["kbl.h2.reported_pbt", "kbl.h1.effective_tax_rate"], "output_metric": "2026年下半年报表所得税", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.reported_net", "operator": "subtract", "inputs": ["kbl.h2.reported_pbt", "kbl.h2.reported_tax"], "output_metric": "2026年下半年报表净利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.reported_attributable", "operator": "subtract", "inputs": ["kbl.h2.reported_net", "kbl.h1.nci_profit"], "output_metric": "2026年下半年报表归母利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.fy2026.reported_attributable_profit", "operator": "sum", "inputs": ["kbl.h1.attributable_profit", "kbl.h2.reported_attributable"], "output_metric": "2026财年报表归母利润（含下半年公允价值变动）", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.fy2026.revenue", "operator": "sum", "inputs": ["kbl.h1.revenue", "kbl.h2.revenue"], "output_metric": "2026财年收入", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000}
  ]
