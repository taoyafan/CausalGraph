    {"id": "kbl.h2.core_net", "operator": "subtract", "inputs": ["kbl.h2.core_pbt", "kbl.h2.core_tax"], "output_metric": "2026年下半年核心净利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
    {"id": "kbl.h2.core_attributable", "operator": "subtract", "inputs": ["kbl.h2.core_net", "kbl.h1.nci_profit"], "output_metric": "2026年下半年核心归母利润", "unit": "HKD", "display_unit": "亿港元", "display_scale": 100000000},
